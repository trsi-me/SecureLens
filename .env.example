# انسخ هذا الملف باسم .env وعدّل القيم حسب الحاجة
SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=sqlite:///instance/scans.db

# اختياري: لتفعيل توصيات مبنية على نموذج ذكاء اصطناعي حقيقي بدل المحرك المدمج
AI_PROVIDER=
AI_API_KEY=

REQUEST_TIMEOUT=10
MAX_REDIRECTS=5
SCANNER_USER_AGENT=SecureLens/1.0 (+security-checkup; passive-scanner; contact-site-owner-only)
